# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.
# Leads go to GoHighLevel first; Resend email is the fallback. With neither set, the form tells visitors to call.

# GoHighLevel inbound webhook (Automation → Workflow → Inbound Webhook trigger)
GHL_WEBHOOK_URL=

# Resend fallback: all three are required, or the fallback stays off
RESEND_API_KEY=
LEAD_EMAIL=
LEAD_FROM="Website <leads@your-verified-domain.com>"
